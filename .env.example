# Copy to .env (git-ignored) and fill in fresh values. Never commit .env.
# Generate each key with:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"

# AES-256-GCM key for notes.comment (base64 of 32 random bytes).
COMMENT_KEY=
# HMAC-SHA256 key for the grades CSV export. Must differ from COMMENT_KEY.
EXPORT_HMAC_KEY=
# HS256 secret for signing JWTs (lab Class 7). A 256-bit random value, plain
# string (not base64). Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
